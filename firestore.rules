rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Condo Configuration Collection
    match /condos/{condoId} {
      allow read, write: if isValidId(condoId);
    }

    // Client Condos Multi-management
    match /client_condos/{clientCondoId} {
      allow read, write: if isValidId(clientCondoId);
    }

    // Users and Operators
    match /users/{userId} {
      allow read, write: if isValidId(userId);
    }

    // Access Logs (Gatehouse entries and exits with 2-year retention)
    match /access_logs/{logId} {
      allow read, write: if isValidId(logId);
    }

    // Deliveries and Packages
    match /deliveries/{deliveryId} {
      allow read, write: if isValidId(deliveryId);
    }

    // Vehicles of Residents and Visitors
    match /vehicles/{vehicleId} {
      allow read, write: if isValidId(vehicleId);
    }

    // Residents
    match /residents/{residentId} {
      allow read, write: if isValidId(residentId);
    }

    // Visitors
    match /visitors/{visitorId} {
      allow read, write: if isValidId(visitorId);
    }

    // Contractors / Service providers
    match /contractors/{contractorId} {
      allow read, write: if isValidId(contractorId);
    }

    // Occurrences
    match /occurrences/{occurrenceId} {
      allow read, write: if isValidId(occurrenceId);
    }

    // Shift Handover Book Entries
    match /shift_entries/{shiftId} {
      allow read, write: if isValidId(shiftId);
    }

    // CCTV Cameras & DVR Channels
    match /cctv_cameras/{cameraId} {
      allow read, write: if isValidId(cameraId);
    }

    // Apartments and Units
    match /apartments/{apartmentId} {
      allow read, write: if isValidId(apartmentId);
    }

    // Blocks and Towers
    match /blocks/{blockId} {
      allow read, write: if isValidId(blockId);
    }

    // Common Areas
    match /common_areas/{areaId} {
      allow read, write: if isValidId(areaId);
    }

    // Area Bookings
    match /area_bookings/{bookingId} {
      allow read, write: if isValidId(bookingId);
    }

    // Communication Notices
    match /notices/{noticeId} {
      allow read, write: if isValidId(noticeId);
    }

    // Connection Health Check
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
